<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_bringup</name>
  <version>0.1.0</version>
  <description>LeKiwi Pi 브링업: 로봇 모델 · 센서 · 모터 드라이버 · 베이스 컨트롤러를 한 번에 켜는 launch와 장비별 설정, PC용 RViz launch</description>
  <maintainer email="khw11044@gmail.com">khw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>lekiwi_description</exec_depend>
  <exec_depend>lekiwi_imu</exec_depend>
  <exec_depend>lekiwi_lidar</exec_depend>
  <exec_depend>lekiwi_scan_filter</exec_depend>
  <exec_depend>lekiwi_motor_driver</exec_depend>
  <exec_depend>lekiwi_base_controller</exec_depend>
  <exec_depend>lekiwi_zmq_host</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>lekiwi_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
