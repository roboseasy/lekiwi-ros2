<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_motor_driver</name>
  <version>0.2.0</version>
  <description>LeKiwi 바퀴·팔 Feetech STS3215 버스를 여는 유일한 노드. 모터 9개 상태를 lekiwi_msgs/MotorStateArray로 발행하고, 설정으로 켜면 바퀴 3개에 속도 · 토크를, 팔 6개에 목표 위치 · 토크를 쓴다</description>
  <maintainer email="khw11044@gmail.com">khw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>lekiwi_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
