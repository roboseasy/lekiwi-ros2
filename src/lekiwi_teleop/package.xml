<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_teleop</name>
  <version>0.0.1</version>
  <description>LeKiwi 베이스를 PC에서 조작 · 시험하는 도구 (guarded teleop, 짧은 cmd_vel, Nav2 모터 감독, 거리 시험, odom 보정 계산)</description>
  <maintainer email="khw11044@gmail.com">khw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
